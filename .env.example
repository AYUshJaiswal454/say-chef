# Copy this file to .env.local and fill it in to share recipes through Firebase.
# Leave it empty to run Say Chef in demo mode (recipes stay in your browser).
# Find these values in the Firebase console: Project settings > General > Your apps > SDK setup and configuration.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
